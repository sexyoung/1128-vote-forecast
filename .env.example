DATABASE_URL="postgresql://vote_forecast:vote_forecast@host.docker.internal:5435/vote_forecast?schema=public"
# 本機 Vite 用 5173，API 獨立用 8787，由 Vite proxy `/api/*`。
PORT=8787

# 正式網域，供 canonical、OG URL 與 sitemap 使用。Preview 留空並強制 noindex。
# PUBLIC_SITE_URL="https://example.com"

REDIS_URL="redis://host.docker.internal:6381"

# 身份訊號的 HMAC pepper。正式環境務必換掉，換掉等於所有指紋線索重來。
FORECASTER_PEPPER="change-me"

# Cloudflare Turnstile。這組是官方文件的測試金鑰，永遠通過，只能用於開發。
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# 後台端點用的權杖，與一般身份無關。
ADMIN_TOKEN="change-me"

# 後台 cookie 的簽章金鑰（HMAC）。正式環境務必換掉；換掉這把等於把所有已登入的
# 後台 session 登出，這就是撤銷機制，不必額外維護一張 session 表。
ADMIN_SESSION_SECRET="change-me"
# 後台 cookie 的有效時數，預設 12。公告當晚只想登入一次，不想每半小時重新輸入。
ADMIN_SESSION_HOURS=12
CRON_SECRET="change-me"
# 沒有 pooler 的直連字串，給本機維護與 Prisma migration 使用。留空就退回
# DATABASE_URL。
# DIRECT_DATABASE_URL="postgresql://vote_forecast:vote_forecast@host.docker.internal:5435/vote_forecast?schema=public"

# 以下三個 VITE_ 開頭的變數是 build 時就烤進前端 bundle 的（vite-plus 靜態取代
# import.meta.env），不是執行時讀的：改值要重新 build，重啟伺服器沒有用；
# Preview 與 Production 兩個 scope 要分開設，不然預覽站的流量會混進正式資料。

# GA4 量測 ID，格式 G-XXXXXXXXXX。留空 = GA 完全關閉（不載 gtag、不發請求）。
# 公開值，出現在前端 bundle 裡是正常的。
# VITE_GA_MEASUREMENT_ID=""

# PostHog 專案 API key，格式 phc_…。留空 = PostHog 完全關閉。這把 key 本來就
# 設計成公開的（只能寫入、不能讀取專案資料）。絕對不要把 PostHog 的
# Personal API key 放進任何 VITE_ 變數。
# VITE_POSTHOG_KEY=""

# PostHog ingestion host。未設定時預設 https://us.i.posthog.com；歐盟專案改成
# https://eu.i.posthog.com。
# VITE_POSTHOG_HOST=""
