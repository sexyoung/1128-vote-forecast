DATABASE_URL="postgresql://vote_forecast:vote_forecast@host.docker.internal:5435/vote_forecast?schema=public"
PORT=8787

REDIS_URL="redis://host.docker.internal:6381"

# 身份訊號的 HMAC pepper。正式環境務必換掉，換掉等於所有指紋線索重來。
FORECASTER_PEPPER="change-me"

# Cloudflare Turnstile。這組是官方文件的測試金鑰，永遠通過，只能用於開發。
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# 物件儲存（開發用 MinIO，正式環境換成 R2 或 S3）。
S3_ENDPOINT="http://host.docker.internal:9002"
S3_REGION="us-east-1"
S3_BUCKET="vote-forecast"
S3_ACCESS_KEY_ID="vote_forecast"
S3_SECRET_ACCESS_KEY="vote_forecast"
S3_PUBLIC_BASE_URL="http://localhost:9002/vote-forecast"

# 後台端點用的權杖，與一般身份無關。
ADMIN_TOKEN="change-me"
